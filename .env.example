# Copy to .env (ignored by git) and fill in. Real environment variables take precedence.
# ShiftSense also reads ~/.config/dshift/.env, which is handy when launching from outside the repo.
# You never need this file: keys can instead be pasted in Settings inside the app, where they are
# stored encrypted with Windows DPAPI. Resolution order: environment > ./.env >
# ~/.config/dshift/.env > the encrypted key stored in the app.

# Anthropic API key from https://console.anthropic.com/settings/keys (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI key, if you switch the provider to OpenAI in Settings or the tray menu
# OPENAI_API_KEY=sk-...

# Optional: no key at all — switch the provider to Ollama for local models (offline chat).

# Optional: where memory, chats and settings live.
# Default: ~/DShift
# DSHIFT_DATA_DIR=C:\Users\you\Documents\shiftsense
