{
  "author": "D Shift",
  "build": {
    "appId": "app.dshift.sidebar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "native/**",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false
    },
    "productName": "D Shift",
    "win": {
      "artifactName": "D-Shift-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {},
  "description": "D Shift \u2014 a screen-aware AI sidebar for Windows. Double-tap Shift anywhere, ask about what's on your screen. Accessibility-first context, local markdown memory, approval-gated Codex handoff.",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "dshift",
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "scripts": {
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js && for f in src/*.js; do node --check $f || exit 1; done && echo ALL_SYNTAX_OK",
    "dist:win": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "start": "electron .",
    "shot": "electron tests/ui-shot.js",
    "test": "node --test tests/*.test.js"
  },
  "version": "1.0.0"
}